# Copy to backend/.env and fill in real values. Never commit .env.
#
# Status column:
#   used   read by code in this repository today
#   plan   needed when the Django project, Postgres store, workers or model adapters are built
#
# Secrets (database password, Django secret, any model API key) come from the host's secret
# store in staging and production, never from a file in the repository.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# dev | demo | staging | production. Demo data loads only in dev and demo.        [used]
APP_ENV=dev

# Contact address sent in the User-Agent to job boards. Employers can use it to
# reach us about listings. Required before any live fetch.                         [used]
YPP_INGEST_CONTACT=you@yourdomain.org

# ---------------------------------------------------------------------------
# Search and scoring
# ---------------------------------------------------------------------------

# Default minimum score for search results (PDF section 7).                       [used]
MATCH_MIN_SCORE_DEFAULT=40

# Reciprocal rank fusion constant (TECHNICAL.md section 5.3).                     [used]
RRF_K=60

# Embedding vector size. Must match the embedding model and the vector column.    [used]
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Models (provider-neutral: no vendor is tied to the design)
# ---------------------------------------------------------------------------

# local  self-hosted model in the worker, no third-party API             [plan]
# none   embeddings off. Search runs on keywords only                    [plan]
EMBEDDING_PROVIDER=local

# Default is BAAI/bge-m3: MIT licence, 1024-dimension dense vectors, 100+ languages.
# Changing the model means re-embedding every row (TECHNICAL.md section 16).     [plan]
EMBEDDING_MODEL=BAAI/bge-m3

# none is the only value with an adapter today. Rerank, free-text parsing and profile
# extraction stay off until a provider is chosen and its adapter is built.       [used]
LLM_PROVIDER=none

# Model name for the chosen LLM provider. Ignored while LLM_PROVIDER=none.      [plan]
LLM_MODEL=

# ---------------------------------------------------------------------------
# Database (Render Postgres, pgvector and pg_trgm enabled)                         [plan]
# ---------------------------------------------------------------------------

# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://ypp:change-me@localhost:5432/ypp

# ---------------------------------------------------------------------------
# Redis-compatible broker and cache (Render Key Value)                             [plan]
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Django (not yet built)                                                           [plan]
# ---------------------------------------------------------------------------

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
